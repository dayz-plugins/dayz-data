{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dayz-plugins.github.io/schema/build.schema.json",
  "title": "dayz-data build file",
  "description": "Addresses and struct offsets resolved for one executable, keyed by its SHA-256.",
  "type": "object",
  "required": ["schema", "build"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 2 },
    "build": {
      "type": "object",
      "required": ["version", "executable", "sha256", "file_size"],
      "additionalProperties": false,
      "properties": {
        "version": { "type": "string", "description": "Human readable build number." },
        "executable": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "file_size": { "type": "integer", "minimum": 1 },
        "pe_timestamp": { "$ref": "#/$defs/hex" },
        "image_size": { "$ref": "#/$defs/hex" },
        "verified": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "provenance": { "enum": ["verified", "analysis", "scan", "external"] }
      }
    },
    "symbols": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "required": ["rva"],
        "additionalProperties": false,
        "properties": {
          "rva": { "$ref": "#/$defs/hex" },
          "kind": { "enum": ["function", "global", "instruction"] },
          "check": { "$ref": "#/$defs/pattern" },
          "note": { "type": "string" }
        }
      }
    },
    "offsets": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "required": ["value"],
        "additionalProperties": false,
        "properties": {
          "value": { "$ref": "#/$defs/hex" },
          "note": { "type": "string" }
        }
      }
    },
    "events": {
      "description": "Event classes the engine can raise, keyed by the class name the engine itself reports. An entry with no fields is a class that is known but not decoded.",
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/class" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "vtable": { "$ref": "#/$defs/hex" },
          "note": { "type": "string" },
          "fields": {
            "description": "In the order the script Param lists them, which is not memory order.",
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "offset", "kind"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                "offset": { "$ref": "#/$defs/hex" },
                "kind": { "enum": ["int", "float", "bool", "string", "vector", "object"] },
                "script_type": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" },
    "name": { "type": "string", "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
    "class": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9_]*$" },
    "pattern": { "type": "string", "pattern": "^([0-9A-Fa-f]{2}|\\?\\?)( ([0-9A-Fa-f]{2}|\\?\\?))*$" }
  }
}
